generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  role      String
  email     String   @unique
  avatar    String?
  posName   String?
  pitArea   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Truck {
  id               Int        @id @default(autoincrement())
  code             String     @unique
  truckNumber      String
  truckType        String
  truckTypeLabel   String
  brand            String?
  hullNumber       String?
  equipmentId      String?
  ownerName        String?
  notes            String?
  registeredBy     String
  registeredByRole String
  registeredAt     DateTime   @default(now())
  status           String
  photo            String?
  lastUpdatedBy    String?
  lastUpdatedAt    DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  checkouts        Checkout[]

  @@index([truckNumber])
  @@index([hullNumber])
  @@index([status])
}

model Checkout {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  truckId        Int
  truckCode      String
  truckNumber    String
  truckType      String
  truckTypeLabel String
  materialType   String?
  pitOwner       String
  excaId         String
  excaOperator   String
  contractor     String?
  createdBy      String
  createdByRole  String
  createdAt      DateTime @default(now())
  status         String
  verifiedBy     String?
  verifiedAt     DateTime?
  photo          String?
  updatedAt      DateTime @updatedAt
  truck          Truck    @relation(fields: [truckId], references: [id], onDelete: Restrict)

  @@index([truckId])
  @@index([truckCode])
  @@index([status])
  @@index([materialType])
  @@index([contractor])
}



model HeavyEquipment {
  id               Int        @id @default(autoincrement())
  code             String     @unique
  equipmentId      String     @unique
  brand            String?
  type             String?
  ownerName        String?
  notes            String?
  registeredBy     String
  registeredByRole String
  registeredAt     DateTime   @default(now())
  status           String     @default("active")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([equipmentId])
  @@index([status])
}

model LocationData {
  id               Int        @id @default(autoincrement())
  code             String     @unique
  name             String
  ownerName        String?
  notes            String?
  registeredBy     String
  registeredByRole String
  registeredAt     DateTime   @default(now())
  status           String     @default("active")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([name])
  @@index([status])
}

model ContractorData {
  id               Int        @id @default(autoincrement())
  code             String     @unique
  name             String
  contactPerson    String?
  contactNumber    String?
  address          String?
  notes            String?
  registeredBy     String
  registeredByRole String
  registeredAt     DateTime   @default(now())
  status           String     @default("active")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([name])
  @@index([status])
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
